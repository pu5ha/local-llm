# Access key for /admin/catalog, the manual catalog-refresh endpoint, and the
# news refresh endpoint (POST /api/news).
# Visit /admin/catalog?key=<value> to review new/uncurated models.
ADMIN_ACCESS_KEY=

# Free-tier API key for the Artificial Analysis Data API (used by the
# "Open vs Closed" tab to compute the live open-vs-closed model gap).
# Get one free at https://artificialanalysis.ai/ (sign up -> API/Data tab).
# Free tier: 100 requests/24h -- plenty for a server-cached, 12h-revalidated fetch.
ARTIFICIAL_ANALYSIS_API_KEY=

# Telegram bot token from @BotFather (create a bot, copy the token here).
# Used by src/lib/telegram/bot.ts to talk to the Telegram Bot API.
TELEGRAM_BOT_TOKEN=

# The public channel the bot posts new /news items to, as "@channelusername"
# (create a Telegram Channel, then add your bot as an admin with "Post
# Messages" permission). Must match the @username exactly, including the "@".
TELEGRAM_CHANNEL_ID=

# Random secret you choose. Checked against the `X-Telegram-Bot-Api-Secret-Token`
# header Telegram sends with every webhook request (POST /api/telegram/webhook),
# so only real Telegram traffic can trigger bot commands.
TELEGRAM_WEBHOOK_SECRET=

# Upstash Redis REST credentials (free database at https://upstash.com) --
# stores the "last notified article" cursor so the notify cron only posts
# items the channel hasn't seen yet.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random string (16+ chars) for securing the scheduled news-notify job.
# When this is set as a Vercel project env var, Vercel automatically sends it
# as `Authorization: Bearer <value>` on every GET /api/telegram/cron request
# triggered by vercel.json's cron schedule. Manual triggers can instead use
# the existing ADMIN_ACCESS_KEY via the `x-admin-key` header.
CRON_SECRET=

# Google Gemini API key, used to rewrite /news items into plain language (see
# src/lib/news/plainLanguage/). Optional -- without it, the feed still works,
# it just shows cleaned-up raw text instead of a plain-language rewrite.
# Get one free at https://aistudio.google.com/apikey (Google AI Studio, not
# Vertex AI -- no credit card required). The free tier (~1,000 requests/day
# on Gemini's Flash-Lite tier) comfortably covers this feature's usage.
GEMINI_API_KEY=
